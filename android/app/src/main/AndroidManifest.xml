<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 데이터 자동 갱신(OTA) 확인·수신용. 평소 시뮬레이터는 완전 오프라인 동작. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 이미지(성능 카드 PNG) 를 Download 폴더에 저장. Android 10(Q)+ 는 MediaStore 라 권한 불필요. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="GBO2 파츠 시뮬"
        android:icon="@android:drawable/sym_def_app_icon"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 성능 카드 PNG 를 클립보드로 넘기기 위한 제공자.
             클립보드는 이미지를 직접 못 담고 content:// URI 만 받는다.
             exported=false + grantUriPermissions=true 라, 우리가 클립에 담아 준 URI 만
             받는 앱이 읽을 수 있다(폴더를 통째로 여는 게 아니다). -->
        <provider
            android:name=".ImageProvider"
            android:authorities="com.gbo2.sim.images"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
