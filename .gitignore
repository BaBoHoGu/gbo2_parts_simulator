# 의존성 — 검증 도구용으로만 --no-save 설치한다
node_modules/
package-lock.json

# 빌드 산출물 — `node tools/build.js` 로 언제든 다시 만든다
dist/

# 검증 부산물
shots/
tools/_original_calc.js   # extract_original_calc.js 가 raw/app.js 에서 생성

# 위키 원본 캐시 (~170MB) — `node tools/fetch_wiki.js` 로 다시 받는다.
# 추출 결과인 data/weapons.json 만 버전 관리한다.
raw/wiki/

# 업데이트 감지용 임시 다운로드 (tools/update.js) — 언제든 다시 받는다.
raw/remote/

# 임시 파일
_*.js
*.log
data/buff_skills.json
release/

# 하네스가 세션 중 권한 허용 규칙을 자동 추가하는 로컬 설정 (머신별 절대경로 포함) — 추적 안 함
.claude/settings.json
