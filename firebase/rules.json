// GBO2 공유 갤러리 — Realtime Database 보안 규칙
//
// 붙여넣는 곳: Firebase 콘솔 → 빌드 → Realtime Database → 「규칙」 탭 → 전체 교체 → 게시
// 먼저 dist/firebase-seed.json 을 루트에 「JSON 가져오기」 해야 합니다(사전이 없으면 모든 업로드가 거부됩니다).
//
// 설계 요지
//   · 규칙은 base64 를 풀 수 없다 → 기체·파츠 '이름'을 따로 올리게 하고 dict 와 대조한다.
//   · 그래서 앱은 올라온 base64 를 믿을 필요가 없다. 검증된 필드로 구성을 다시 조립한다.
//   · 규칙에는 자식 개수를 세는 함수가 없다 → 파츠 칸을 p0~p7 로 고정해 8개 상한을 만든다.
//   · 익명 로그인으로 uid 를 얻어 1분에 1건으로 제한한다. 사용자 눈에는 아무것도 안 보인다.
{
  "rules": {
    ".read": false,
    ".write": false,

    // 화이트리스트. 클라이언트는 읽을 필요가 없다(앱이 같은 데이터를 이미 갖고 있다).
    // 규칙 평가는 .read 와 무관하게 언제나 이 값을 볼 수 있다.
    "dict": { ".read": false, ".write": false },

    // 숨길 글 목록. 앱이 읽어서 걸러 낸다. 쓰기는 콘솔에서만.
    "blocked": { ".read": true, ".write": false },

    // 속도 제한 — 업로드 직전에 여기를 먼저 찍게 한다.
    // 60초가 안 지났으면 이 쓰기가 거부되고, 그러면 아래 builds 쓰기도 통과하지 못한다.
    "throttle": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && $uid === auth.uid",
        ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || newData.val() > data.val() + 60000)"
      }
    },

    "builds": {
      ".read": true,
      ".indexOn": ["at"],

      // $fp = 구성 지문(같은 조합이면 같은 키) → 중복 업로드가 키 충돌로 자동 거절된다.
      "$fp": {
        // 새 글만. 수정·삭제 불가(지우는 것은 콘솔에서).
        // throttle 을 방금(15초 내) 찍은 사람만 쓸 수 있다 → 1분 1건이 강제된다.
        ".write": "auth != null && !data.exists() && root.child('throttle').child(auth.uid).val() > now - 15000",
        ".validate": "newData.hasChildren(['ms','stage','exp','expLv','at','uid','ver'])",

        "ms":    { ".validate": "root.child('dict/ms').child(newData.val()).exists()" },
        "p0":    { ".validate": "root.child('dict/parts').child(newData.val()).exists()" },
        "p1":    { ".validate": "root.child('dict/parts').child(newData.val()).exists()" },
        "p2":    { ".validate": "root.child('dict/parts').child(newData.val()).exists()" },
        "p3":    { ".validate": "root.child('dict/parts').child(newData.val()).exists()" },
        "p4":    { ".validate": "root.child('dict/parts').child(newData.val()).exists()" },
        "p5":    { ".validate": "root.child('dict/parts').child(newData.val()).exists()" },
        "p6":    { ".validate": "root.child('dict/parts').child(newData.val()).exists()" },
        "p7":    { ".validate": "root.child('dict/parts').child(newData.val()).exists()" },
        "exp":   { ".validate": "root.child('dict/exp').child(newData.val()).exists()" },

        "stage": { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 4 || newData.val() === 6)" },
        "expLv": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },

        // 제목은 선택. 길이와 문자 범위를 좁혀 둔다(한글·영문·숫자·공백·일부 기호).
        "title": { ".validate": "newData.isString() && newData.val().length <= 20 && newData.val().matches(/^[가-힣ㄱ-ㅎA-Za-z0-9 ·\\-_.,!?()\\[\\]]*$/)" },

        // 날짜 위조 금지 — 서버 시각만 허용.
        "at":    { ".validate": "newData.isNumber() && newData.val() === now" },
        // 올린 사람 표시(익명 uid). 남의 uid 로는 못 쓴다.
        "uid":   { ".validate": "newData.val() === auth.uid" },
        // 어느 데이터 버전에서 만든 구성인지 (예: "2026-09-07").
        "ver":   { ".validate": "newData.isString() && newData.val().length <= 12" },

        // 위에 정의하지 않은 필드는 일절 금지.
        "$other": { ".validate": false }
      }
    }
  }
}
